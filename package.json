{
  "name": "skyros-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "biome check",
    "fix": "biome check --write",
    "typecheck": "tsc",
    "test": "vitest run",
    "verify": "npm run check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
